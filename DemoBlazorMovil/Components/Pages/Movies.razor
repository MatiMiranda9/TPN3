        height: 260px;
        object-fit: cover;
        border-radius: 12px 12px 0 0;
    }

    .movie-year {
        font-weight: normal;
        font-size: 0.9rem;
    }

    .movie-genre {
        font-size: 0.9rem;
        color: #444;
    }

    .funciones-title {
        margin-top: 10px;
        font-weight: 600;
    }

    .funcion-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        border-radius: 8px;
        padding: 8px 10px;
        margin-top: 6px;
    }

    .funcion-info {
        display: flex;
        flex-direction: column;
    }

    .funcion-hora {
        font-weight: 600;
    }

    .funcion-sala {
        font-size: 0.85rem;
        color: #555;
    }

    .funcion-precio {
        font-size: 0.85rem;
    }

    .btn-comprar {
        font-size: 0.8rem;
    }

    .admin-footer {
        background: transparent;
        border: none;
    }

    .h-card {
        background-color: rgba(5, 5, 5, 0.55);
        color: #D65D00;
        border-radius: 15px;
        padding: 20px;
        text-align: center;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.2s ease;
        margin-right:15px;
        margin-left:15px;
        margin-bottom:10px;

    }
</style>