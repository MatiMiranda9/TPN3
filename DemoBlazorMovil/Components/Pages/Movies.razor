@page "/movies"
@using DemoBlazorMovil.Shared.DTOs
@using DemoBlazorMovil.Services
@using Microsoft.AspNetCore.Components.Forms
@inject MovieService MovieService
@inject SalaService SalaService
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="cartelera-bg ">
    
    <div class="h-card" >
        <h3 class="cartelera-title">
            <i class="bi bi-film"></i> Cartelera
        </h3>
    </div>
    
    @if (AuthService.esAdmin)
    {
        <button class="btn btn-primary mb-1" @onclick="NewMovie">
            <i class="bi bi-plus-square"></i> Nueva Película
        </button>

        <button class="btn-toggle btn-warning" style="margin:5px;border:0px;" @onclick="ToggleInactivos">
            @(mostrarInactivos ? "Ver activos" : "Ver inactivos")
        </button>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4">

        @foreach (var movie in movies.Where(m => m.IsActive != mostrarInactivos))
        {
            <div class="col">
                <div class="card movie-card h-100 shadow-sm">

                    <img src="@movie.ImagePath"
                         class="card-img-top movie-img"
                         alt="@movie.Title" />

                    <div class="card-body">

                        <h5 class="card-title">
                            @movie.Title
                            <span class="movie-year">(@movie.Year)</span>
                        </h5>

                        <p class="movie-genre">@movie.Genre</p>

                        <h6 class="funciones-title">Funciones</h6>

                        @if (movie.Showtimes != null && movie.Showtimes.Any(s => s.IsActive))
                        {
                            @foreach (var func in movie.Showtimes.Where(s => s.IsActive))
                            {
                                <div class="funcion-item">

                                    <div class="funcion-info">

                                        <div class="funcion-hora">
                                            @func.Time.ToString("dd/MM HH:mm")
                                        </div>

                                        <div class="funcion-sala">
                                            @func.SalaNombre
                                        </div>

                                        <div class="funcion-precio">
                                            $@func.Price
                                        </div>

                                    </div>
                                    @if (AuthService.IsLoggedIn)
                                    {
                                        if (AuthService.esAdmin)
                                        {
                                            
                                        }
                                        else
                                        {
                                            <button class="btn btn-warning btn-sm btn-comprar"
                                                    @onclick="@(() => Nav.NavigateTo("/tickets/" + func.Id))">
                                                🎟 Comprar
                                            </button>
                                        }
                                    }
                                    

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Sin funciones disponibles</p>
                        }

                    </div>

                    @if (AuthService.esAdmin)
                    {
                        <div class="card-footer admin-footer">

                            @if (!movie.IsActive)
                            {

                                <button class="btn-reactivar btn-warning"
                                        @onclick="() => ActivarMovie(movie.Id)">
                                    Reactivar
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-warning me-2"
                                        @onclick="() => EditMovie(movie)">
                                    <i class="bi bi-pencil-square">Editar</i>
                                </button>

                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => DeleteMovie(movie.Id)">
                                    <i class="bi bi-trash">Eliminar</i>
                                </button>

                            }

                            

                        </div>
                    }

                </div>
            </div>
        }

    </div>
</div>


<div class="modal fade" id="movieModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@((currentMovie.Id == 0) ? "Nueva Película" : "Editar Película")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="currentMovie" OnValidSubmit="SaveMovie">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <InputText class="form-control" @bind-Value="currentMovie.Title" />
                        <ValidationMessage For="@(() => currentMovie.Title)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Género</label>
                        <InputText class="form-control" @bind-Value="currentMovie.Genre" />
                        <ValidationMessage For="@(() => currentMovie.Genre)" />

                    </div>

                    <div class="mb-3">
                        <label class="form-label">Año</label>
                        <InputNumber class="form-control" @bind-Value="currentMovie.Year" />
                        <ValidationMessage For="@(() => currentMovie.Year)" />

                    </div>

                    <div class="mb-3">
                        <label class="form-label">Imagen (ruta local)</label>
                        <InputText class="form-control" @bind-Value="currentMovie.ImagePath" />
                    </div>

                    <h6>Funciones</h6>
                    @foreach (var func in currentMovie.Showtimes.Where(s => s.IsActive))
                    {
                        var i = currentMovie.Showtimes.IndexOf(func);
                        <div class="border p-2 mb-2 rounded">
                            <label>Inicio</label>
                            <input type="datetime-local" class="form-control"
                                   @bind-value="currentMovie.Showtimes[i].Time"/>

                            <div class="mb-3">
                                <label class="form-label">Sala</label>

                                <InputSelect class="form-select"
                                             @bind-Value="currentMovie.Showtimes[i].SalaId">

                                    <option value="0">-- Seleccionar Sala --</option>

                                    @foreach (var sala in salas)
                                    {
                                        <option value="@sala.Id">
                                            @sala.Nombre (Capacidad: @sala.Capacidad)
                                        </option>
                                    }

                                </InputSelect>
                            </div>


                            <label>Precio</label>
                            <InputNumber class="form-control" @bind-Value="currentMovie.Showtimes[i].Price" />


                            <button type="button" class="btn btn-sm mt-1 btn-outline-danger"
                                    @onclick="() => DisableShowtime(func.Id)">
                                Desactivar
                            </button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <button type="button" class="btn btn-sm btn-secondary mb-3" @onclick="AddShowtime">
                        <i class="bi bi-plus-circle"></i> Agregar función
                    </button>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">Guardar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MovieDTO> movies = new();
    private List<SalaDTO> salas = new();
    private MovieDTO currentMovie = new();
    private string? errorMessage;
    private bool mostrarInactivos = false;

    void ToggleInactivos()
    {
        mostrarInactivos = !mostrarInactivos;
    }

    protected override async Task OnInitializedAsync()
    {
        movies = await MovieService.GetAll();
        salas = await SalaService.GetAll();
    }

    private async Task SaveMovie()
    {
        errorMessage = null;
        try
        {
            bool ok;
            if (currentMovie.Id == 0)
            {
                var created = await MovieService.Add(currentMovie);
                ok = created != null;
            }
            else
            {
                ok = await MovieService.Update(currentMovie);
            }

            if (!ok)
            {

                errorMessage = "Complete todos los campos para guardar.";
                return;
            }

            movies = await MovieService.GetAll();
            currentMovie = new MovieDTO { Showtimes = new List<ShowtimeDTO>() };
            await HideModal();
        }
        catch
        {
            errorMessage = "⚠️ Ocurrió un error inesperado al guardar.";
        }
    }

    private void EditMovie(MovieDTO movie)
    {
        errorMessage = null;
        currentMovie = new MovieDTO
        {
            Id = movie.Id,
            Title = movie.Title,
            Genre = movie.Genre,
            Year = movie.Year,
            ImagePath = movie.ImagePath,
            Showtimes = movie.Showtimes.Select(s => new ShowtimeDTO
            {
                Id = s.Id,
                Time = s.Time,
                SalaId = s.SalaId,
                Price = s.Price,
                IsActive = s.IsActive,
                MovieId = movie.Id
            }).ToList()
        };

        ShowModal();
    }

    private void NewMovie()
    {
        errorMessage = null;
        currentMovie = new MovieDTO
        {
            Id = 0,
            Title = "",
            Genre = "",
            Year = DateTime.Now.Year,
            ImagePath = "images/movies/generico.jpg",
            Showtimes = new List<ShowtimeDTO>()
        };

        ShowModal();
    }

    async Task ActivarMovie(int id)
    {
        var ok = await MovieService.Activar(id);

        if (ok)
        {
            var movie = movies.FirstOrDefault(u => u.Id == id);
            if (movie != null)
                movie.IsActive = true;
            StateHasChanged();
        }
    }

    async Task DeleteMovie(int id)
    {
        var ok = await MovieService.Delete(id);

        if (ok)
        {
            var movie = movies.FirstOrDefault(m => m.Id == id);
            if (movie != null)
                movie.IsActive = false;

            StateHasChanged();
        }
    }

    private void AddShowtime()
    {
        currentMovie.Showtimes.Add(new ShowtimeDTO
        {
            Time = DateTime.Now,
            SalaId = 1,
            Price = 0,
            MovieId = currentMovie.Id
        });
    }


    async Task DisableShowtime(int id)
    {
        await MovieService.DisableShowtime(id);

        var show = currentMovie.Showtimes.FirstOrDefault(s => s.Id == id);
        if (show != null)
        {
            show.IsActive = false;
        }

        StateHasChanged();
    }

    private void ShowModal() => JS.InvokeVoidAsync("bootstrapModal.show", "#movieModal");
    private Task HideModal() => JS.InvokeVoidAsync("bootstrapModal.hide", "#movieModal").AsTask();

    [Inject] private IJSRuntime JS { get; set; }
}

<style>

