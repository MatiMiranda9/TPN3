@page "/carrito"
@using DemoBlazorMovil.Services
@using DemoBlazorMovil.Shared.DTOs
@using System.Net.Http.Json
@inject CartService CartService
@inject AuthService AuthService
@inject VentaService VentaService
@inject NavigationManager Nav

<div class="carrito-container">

    <h2 class="carrito-titulo">
        🛒 Tu Carrito
    </h2>

    @if (!CartService.Items.Any() && !CartService.Tickets.Any())
    {
        <div class="carrito-vacio">
            <div class="icono-vacio">🛍️</div>
            <h4>Tu carrito está vacío</h4>
            <p>Agregá productos desde el menú para comenzar tu compra.</p>

            <button class="btn-vacio" @onclick="IrAlInicio">
                Explorar productos
            </button>
        </div>
    }
    else
    {
        @foreach (var item in CartService.Items)
        {
            <div class="cart-item">
                <img src="@item.ImagePath" />

                <div class="cart-info">
                    <h5>@item.Nombre</h5>
                    <p class="precio-unitario">$@item.Precio</p>

                    <div class="contador">
                        <button @onclick="() => CartService.Decrease(item.ArticuloId)">−</button>
                        <span>@item.Cantidad</span>
                        <button @onclick="() => CartService.Increase(item.ArticuloId)">+</button>
                    </div>

                    <p class="subtotal">
                        Subtotal: <strong>$@item.Subtotal</strong>
                    </p>

                    <button class="btn-eliminar"
                            @onclick="() => CartService.RemoveItem(item.ArticuloId)">
                        Eliminar
                    </button>
                </div>
            </div>
        }

        @if (CartService.Tickets.Any())
        {
            <h4>Tickets</h4>

            @foreach (var t in CartService.Tickets)
            {
                <div class="ticket-cardWrap">

                    <div class="ticket-card ticket-cardLeft">

                        <h1>ITES <span>Cinema</span></h1>

                        <div class="ticket-title">
                            <h2>@t.MovieNombre</h2>
                            <span>Película</span>
                        </div>

                        <div class="ticket-seat">
                            <h2>@t.Sala - @t.Asiento</h2>
                            <span>Sala - Asiento</span>
                        </div>

                        <div class="ticket-time">
                            <h2>@t.Fecha.ToString("dd/MM HH:mm")</h2>
                            <span>Función</span>
                        </div>

                        <div class="ticket-price">
                            <h2>$@t.Precio</h2>
                            <span>Precio</span>
                        </div>

                    </div>

                    <div class="ticket-card ticket-cardRight">

                        <div class="ticket-eye"></div>

                        <div class="ticket-number">
                            <h3>@t.Asiento</h3>
                            <span>Asiento</span>
                        </div>

                        <div class="ticket-barcode"></div>

                    </div>

                </div>

                <button class="btn-eliminar"
                        @onclick="() => CartService.RemoveTicket(t.ShowtimeId,t.Asiento)">
                    Eliminar
                </button>
            }
        }

        <div class="carrito-total">
            <h3>Total</h3>
            <h2>$@CartService.GetTotal()</h2>
        </div>

        <button class="btn-confirmar-compra"
                @onclick="ConfirmarCompra">
            Confirmar compra
        </button>
    }

</div>

@if (mostrarModalExito && compraExitosa != null)
{
    <div class="modal-overlay">
        <div class="modal-compra">
            <h2>🎉 ¡Gracias por tu compra!</h2>

            <p><strong>Código:</strong></p>
            <div class="codigo-compra">
                @compraExitosa.codigo
            </div>

            <p>Total pagado:</p>
            <h4>$@compraExitosa.total</h4>

            <div class="modal-botones">
                <button class="btn-secundario" @onclick="@(() => Nav.NavigateTo("/market"))">
                    Seguir comprando
                </button>

                <button class="btn-principal" @onclick="IrAlInicio">
                    Ir al inicio
                </button>
            </div>
        </div>
    </div>
}

@code{
    private bool mostrarToast = false;
    private string mensajeToast = "";
    private bool esErrorToast = false;
    private bool mostrarModalExito = false;
    private CompraResponseDTO? compraExitosa;

    private void IrAlInicio()
    {
        mostrarModalExito = false;
        Nav.NavigateTo("/menu");
    }

    private async Task ConfirmarCompra()
    {
        var dto = new ConfirmarCompraDTO
        {
            UserId = AuthService.CurrentUser.Id,
            Articulos = CartService.Items.Select(i => new ArticuloCompraDTO
            {
                ArticuloId = i.ArticuloId,
                Cantidad = i.Cantidad
            }).ToList(),

            Tickets = CartService.Tickets.Select(t => new TicketCompraDTO
            {
                ShowtimeId = t.ShowtimeId,
                Asiento = t.Asiento
            }).ToList()

        };

        var result = await VentaService.ConfirmarCompra(dto);

        if (result.Success && result.Data != null)
        {
            compraExitosa = result.Data;
            mostrarModalExito = true;
            CartService.Clear();
        }
        else
        {
            mensajeToast = result.Message;
            esErrorToast = true;
            mostrarToast = true;

            StateHasChanged();
            await Task.Delay(3000);
            mostrarToast = false;
        }
    }
}

