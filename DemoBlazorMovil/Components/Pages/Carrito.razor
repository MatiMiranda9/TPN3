.toast-custom {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    padding: 14px 22px;
    border-radius: 12px;
    color: white;
    font-weight: 600;
    z-index: 9999;
    animation: fadeInOut 3s ease forwards;
}

    .toast-custom.success {
        background-color: #4caf50;
    }

    .toast-custom.error {
        background-color: #e53935;
    }

    @@keyframes fadeInOut {
        0%

    {
        opacity: 0;
        transform: translate(-50%, 20px);
    }

    10% {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    90% {
        opacity: 1;
    }

    100% {
        opacity: 0;
        transform: translate(-50%, 20px);
