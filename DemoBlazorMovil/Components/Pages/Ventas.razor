@page "/ventas"
@using DemoBlazorMovil.Shared.DTOs
@inject HttpClient Http

<h2 class="titulo">Ventas</h2>

<div class="buscador">
    <input placeholder="Ingresar código de compra"
           @bind="codigoBusqueda" />

    <button class="btn-buscar"
            @onclick="BuscarVenta">
        Buscar
    </button>
</div>

@if (ventaEncontrada != null)
{
    <div class="venta-detalle">
        <h4>Venta encontrada</h4>

        <p><b>Código:</b> @ventaEncontrada.Codigo</p>
        <p><b>Fecha:</b> @ventaEncontrada.Fecha</p>
        <p><b>Total:</b> $@ventaEncontrada.Total</p>

        <button class="btn-detalle"
                @onclick=" async () => await VerDetalle(ventaEncontrada)">
            Ver detalle
        </button>
    </div>
}

<h4 class="mt-4">Ventas recientes</h4>

@if (ventas == null)
{
    <p>Cargando...</p>
}
else
{
    @foreach (var v in ventas)
    {
        <div class="venta-card">

            <div>
                <p><b>Código:</b> @v.Codigo</p>
                <p>@v.Fecha</p>
            </div>

            <div>
                <p>$@v.Total</p>

                <button class="btn-detalle"
                        @onclick=" async () => await VerDetalle(v)">
                    Ver
                </button>
            </div>

        </div>
    }
}

@if (ventaDetalle != null)
{
    <div class="modal-overlay">

        <div class="modal-venta">

            <h4>Detalle de venta</h4>

            <p><b>Código:</b> @ventaDetalle.Codigo</p>
            <p><b>Fecha:</b> @ventaDetalle.Fecha</p>
            
            @if (ventaDetalle.Articulos.Any())
            {
                <h5>Artículos</h5>

                @foreach (var a in ventaDetalle.Articulos)
                {
                    <p>@a.Nombre X @a.Cantidad</p>
                }
            }
            
            @if (ventaDetalle.Tickets.Any())
            {
                <h5>Tickets</h5>

                @foreach (var t in ventaDetalle.Tickets)
                {
                    <p>@t.MovieNombre - @t.Fecha</P>
                    <p>@t.Sala - Asiento @t.Asiento</p>
                }
            }
            

            <h4>Total: $@ventaDetalle.Total</h4>

            <button class="btn-cerrar"
                    @onclick="() => ventaDetalle = null">
                Cerrar
            </button>

        </div>

    </div>
}

@code {

    private List<VentaDTO> ventas;
    private VentaDTO ventaEncontrada;

    private VentaDTO ventaDetalle;

    private string codigoBusqueda;

    protected override async Task OnInitializedAsync()
    {
        ventas = await Http.GetFromJsonAsync<List<VentaDTO>>("ventas");
    }

    async Task BuscarVenta()
    {
        try
        {
            ventaEncontrada = await Http.GetFromJsonAsync<VentaDTO>(
                $"ventas/codigo/{codigoBusqueda}");
        }
        catch
        {
            ventaEncontrada = null;
        }
    }

   async Task VerDetalle(VentaDTO venta)
{
    try
    {
        ventaDetalle = await Http.GetFromJsonAsync<VentaDTO>(
            $"ventas/codigo/{venta.Codigo}");
    }
    catch
    {
        ventaDetalle = null;
    }
}
}

