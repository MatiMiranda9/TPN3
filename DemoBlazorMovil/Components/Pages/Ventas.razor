        }

    .btn-buscar {
        background: #fbc02d;
        border: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: bold;
    }

    .venta-detalle {
        background: #1e1e1e;
        padding: 14px;
        border-radius: 12px;
        margin-bottom: 10px;
        color: white;
    }

    .venta-card {
        background: #1e1e1e;
        padding: 14px;
        border-radius: 12px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
    }

    .btn-detalle {
        background: #fbc02d;
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
