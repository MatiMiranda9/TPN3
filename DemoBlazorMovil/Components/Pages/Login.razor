@page "/login"
@inherits LayoutComponentBase
@using DemoBlazorMovil.Services
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="login-container">
    <div class="overlay">
        @if (!AuthService.IsLoggedIn)
        {
            <h2 class="login-title">
                <i class="bi bi-person-circle"></i> Iniciar Sesión
            </h2>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="mb-3 text-start">
                <label class="form-label">
                    <i class="bi bi-envelope-fill"></i> Email
                </label>
                <input class="form-control" @bind="email" />
            </div>

            <div class="mb-3 text-start">
                <label class="form-label">
                    <i class="bi bi-lock-fill"></i> Contraseña
                </label>
                <input type="password" class="form-control" @bind="password" />
            </div>

            <button class="btn-login w-100" @onclick="HandleLogin">
                <i class="bi bi-box-arrow-in-right"></i> Ingresar
            </button>
            
             <p>
                ¿No tenés cuenta?
                <a href="/register">Registrarse</a>
             </p>

           }
        else
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                Bienvenido <strong>@AuthService.CurrentUser?.Name</strong>
            </div>

            <button class="btn-logout w-100" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-left"></i> Cerrar sesión
            </button>
        }
    </div>
    </div>

@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;

    private async Task HandleLogin()
    {
        var success = await AuthService.LoginAsync(email, password);

        if (success)
        {
            errorMessage = null;
            Nav.NavigateTo("/menu");
        }
        else
        {
            errorMessage = "Email o contraseña incorrectos";
        }
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Nav.NavigateTo("/login");
    }
}


<style>
    .login-container {
        position: relative;
        min-height: 100vh;
        background: url("images/background/background.png") no-repeat center center fixed;
        background-size: cover;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .overlay {
        background: rgba(0, 0, 0, 0.75);
        padding: 2rem;
        border-radius: 15px;
        text-align: center;
        color: white;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.6);
    }

    .login-title {
        color: #D65D00;
        font-size: 1.8rem;
        margin-bottom: 1.5rem;
        text-shadow: 2px 2px 6px rgba(0,0,0,0.7);
    }

    .form-label {
        font-weight: bold;
        color: #ddd;
    }

    .form-control {
        border-radius: 8px;
        padding: 0.6rem;
    }

    .btn-login {
        background-color: #D65D00;
        color: black;
        font-weight: bold;
        font-size: 1.1rem;
        padding: 0.8rem;
        border: none;
        border-radius: 8px;
        transition: all 0.3s ease;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.5);
    }

        .btn-login:hover {
            background-color: #ffdd33;
            transform: scale(1.05);
        }

    .btn-logout {
        background-color: #ff4444;
        color: white;
        font-weight: bold;
        font-size: 1.1rem;
        padding: 0.8rem;
        border: none;
        border-radius: 8px;
        transition: all 0.3s ease;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.5);
    }

        .btn-logout:hover {
            background-color: #ff6666;
            transform: scale(1.05);
        }

    .bi {
        margin-right: 6px;
    }
</style>
